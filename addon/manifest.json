{
  "manifest_version": 2,
  "name": "Modern Thunderbird – Card Actions",
  "description": "Adds a delete button (next to the star) and a line with the first words of the message to each card in the message list. Styled by the Modern Thunderbird chrome/ stylesheets.",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "modern-thunderbird-actions@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesDelete"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "cardDelete": {
      "schema": "experiments/cardDelete/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "cardDelete"
          ]
        ],
        "script": "experiments/cardDelete/implementation.js",
        "events": [
          "startup"
        ]
      }
    },
    "cardPreview": {
      "schema": "experiments/cardPreview/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "cardPreview"
          ]
        ],
        "script": "experiments/cardPreview/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  }
}
